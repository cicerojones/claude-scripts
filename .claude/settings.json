{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/claude-inbox/bin/inbox-hook.sh\" claude-scripts 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
